{% extends "_layout" %}

{% set result = craft.craftIti.placeDetailWithSeo(id) %}
{% set seomaticActive = craft.app.plugins.isPluginEnabled('seomatic') %}

{% if result.seo is not null %}
    {% if seomaticActive %}
        {% set seomaticAttrs = {canonicalUrl: result.seo.canonicalUrl} %}
        {% if result.seo.title %}{% set seomaticAttrs = seomaticAttrs|merge({seoTitle: result.seo.title}) %}{% endif %}
        {% if result.seo.description %}{% set seomaticAttrs = seomaticAttrs|merge({seoDescription: result.seo.description}) %}{% endif %}
        {% do seomatic.meta.setAttributes(seomaticAttrs) %}
    {% else %}
        {% do craft.app.view.registerLinkTag({rel: 'canonical', href: result.seo.canonicalUrl}) %}
    {% endif %}

    {% if result.seo.structuredData is not empty %}
        {% do craft.app.view.registerScript(result.seo.structuredData|json_encode|raw, 1, {type: 'application/ld+json'}) %}
    {% endif %}
{% endif %}

{% block title %}{% if result.seo is not null and result.seo.title %}{{ result.seo.title }}{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block metaDescription %}{% if result.seo is not null and result.seo.description %}{{ result.seo.description }}{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block content %}
    <div class="container" style="padding: 3rem 0;">
        {{ result.html }}
    </div>
{% endblock %}
