<div id="{{ containerId }}">{{ sanitizedHtml|raw }}</div>
{% if initMethod %}
<script>
  window.itidiAiListingInit = window.itidiAiListingInit || { instances: [] };
  window.itidiAiListingInit.instances.push({
    containerId: {{ containerId|json_encode|raw }},
    initMethod: {{ initMethod|json_encode|raw }},
    bootstrap: {{ bootstrap|json_encode|raw }}
  });
</script>
{% endif %}

{% if structuredData is not empty %}
    <script type="application/ld+json">{{ structuredData|json_encode|raw }}</script>
{% endif %}
