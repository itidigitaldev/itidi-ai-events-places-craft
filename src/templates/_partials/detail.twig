<div id="{{ sourceId }}">{{ sanitizedHtml|raw }}</div>
<div id="{{ shadowId }}" style="display:none;" data-source-id="{{ sourceId }}"></div>
<script>
  window.{{ globalName }} = window.{{ globalName }} || { instances: [], cssAssets: [] };
  window.{{ globalName }}.instances.push({
    sourceId: {{ sourceId|json_encode|raw }},
    shadowId: {{ shadowId|json_encode|raw }},
    bootstrap: {{ bootstrap|json_encode|raw }}
  });
  window.{{ globalName }}.cssAssets = {{ cssAssets|json_encode|raw }};
</script>
<script>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    event: 'itidi_detail_view',
    itidi_type: {{ analyticsData.itidi_type|json_encode|raw }},
    itidi_id: {{ analyticsData.itidi_id|json_encode|raw }},
    itidi_name_id: {{ analyticsData.itidi_name_id|json_encode|raw }},
    itidi_canonical_url: {{ analyticsData.itidi_canonical_url|json_encode|raw }},
    itidi_visited_url: {{ analyticsData.itidi_visited_url|json_encode|raw }}
  });
</script>
