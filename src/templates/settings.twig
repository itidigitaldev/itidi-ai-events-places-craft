{% requireAdmin %}

{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Craft ITI Plugin" %}

{% set crumbs = [
    { label: "Settings"|t('app'), url: url('settings') },
    { label: "Plugins"|t('app'), url: url('settings/plugins') },
] %}

{% block content %}
    {% if not settings.isConnected %}
        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('craft-iti-plugin/settings/connect') }}
            {{ redirectInput('settings/plugins/craft-iti-plugin') }}

            {{ forms.textField({
                label: 'Hubname',
                id: 'hubname',
                name: 'hubname',
                value: settings.hubname,
                errors: settings.getErrors('hubname'),
                required: true,
            }) }}

            {{ forms.textField({
                label: 'API Key',
                instructions: 'Your ITI Digital API key.',
                id: 'apiKey',
                name: 'apiKey',
                value: settings.apiKey,
                errors: settings.getErrors('apiKey'),
                required: true,
            }) }}

            <div class="buttons">
                <button type="submit" class="btn submit">{{ 'Connect' }}</button>
            </div>
        </form>
    {% else %}
        {{ forms.textField({
            label: 'Hubname',
            value: settings.hubname,
            disabled: true,
        }) }}

        {{ forms.textField({
            label: 'API Key',
            value: '••••••••••••',
            disabled: true,
        }) }}

        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('craft-iti-plugin/settings/save') }}
            {{ redirectInput('settings/plugins/craft-iti-plugin') }}

            {% if settings.moduleStatus['events'] %}
                {{ forms.lightswitchField({
                    label: 'Enable Events',
                    id: 'enableEvents',
                    name: 'enableEvents',
                    on: settings.enableEvents,
                }) }}
            {% else %}
                <p class="light">{{ 'Events: not available on this hub.' }}</p>
            {% endif %}

            {% if settings.moduleStatus['places'] %}
                {{ forms.lightswitchField({
                    label: 'Enable Places',
                    id: 'enablePlaces',
                    name: 'enablePlaces',
                    on: settings.enablePlaces,
                }) }}
            {% else %}
                <p class="light">{{ 'Places: not available on this hub.' }}</p>
            {% endif %}

            {% if settings.moduleStatus['itineraries'] ?? false %}
                {{ forms.lightswitchField({
                    label: 'Enable Itineraries',
                    instructions: 'Allow craft.craftIti.itinerariesList() and craft.craftIti.itineraryDetail() to render itinerary content.',
                    id: 'enableItineraries',
                    name: 'enableItineraries',
                    on: settings.enableItineraries,
                }) }}

                {{ forms.elementSelectField({
                    label: 'Itinerary listing entries',
                    instructions: 'Entries whose template renders craft.craftIti.itinerariesList(). Their cache is refreshed when the hub reports itinerary listing changes.',
                    id: 'itineraryListingEntryIds',
                    name: 'itineraryListingEntryIds',
                    elementType: 'craft\\elements\\Entry',
                    elements: itineraryListingEntries ?? [],
                }) }}

                {{ forms.elementSelectField({
                    label: 'Itinerary detail entries',
                    instructions: 'Entries whose template renders craft.craftIti.itineraryDetail(). Their cache is refreshed when the hub reports an itinerary change.',
                    id: 'itineraryDetailEntryIds',
                    name: 'itineraryDetailEntryIds',
                    elementType: 'craft\\elements\\Entry',
                    elements: itineraryDetailEntries ?? [],
                }) }}

                {{ forms.textField({
                    label: 'Default itinerary widget code',
                    instructions: 'Used by craft.craftIti.itinerariesList() when the template doesn\'t pass a widgetCode.',
                    id: 'itineraryDefaultWidgetCode',
                    name: 'itineraryDefaultWidgetCode',
                    value: settings.itineraryDefaultWidgetCode,
                    errors: settings.getErrors('itineraryDefaultWidgetCode'),
                }) }}
            {% else %}
                <p class="light">{{ 'Itineraries: not available on this hub.' }}</p>
            {% endif %}

            {% if settings.moduleStatus['tripPlanner'] ?? false %}
                {{ forms.lightswitchField({
                    label: 'Enable Trip Planner',
                    instructions: 'Load the ITI Digital Trip Planner on site pages. It\'s left off pages that already show ITI content from this plugin.',
                    id: 'enableTripPlanner',
                    name: 'enableTripPlanner',
                    on: settings.enableTripPlanner,
                }) }}

                {{ forms.selectField({
                    label: 'Trip Planner position',
                    id: 'tripPlannerPosition',
                    name: 'tripPlannerPosition',
                    value: settings.tripPlannerPosition,
                    options: [
                        { label: 'Before the closing </body> tag (footer)', value: 'footer' },
                        { label: 'Right after the opening <body> tag', value: 'bodyOpen' },
                    ],
                    errors: settings.getErrors('tripPlannerPosition'),
                }) }}

                {{ forms.selectField({
                    label: 'Where to load the Trip Planner',
                    id: 'tripPlannerLoadingMode',
                    name: 'tripPlannerLoadingMode',
                    value: settings.tripPlannerLoadingMode,
                    options: [
                        { label: 'Everywhere except the paths below', value: 'exclude' },
                        { label: 'Only on the paths below', value: 'include' },
                    ],
                    errors: settings.getErrors('tripPlannerLoadingMode'),
                }) }}

                {{ forms.textareaField({
                    label: 'Trip Planner paths',
                    instructions: 'One path per line, e.g. /contact or /blog/*. A trailing * also matches everything under that path. Full URLs are fine. With no paths, “Everywhere except” loads on every page and “Only on” loads nowhere.',
                    id: 'tripPlannerPaths',
                    name: 'tripPlannerPaths',
                    value: settings.tripPlannerPaths|join("\n"),
                    rows: 5,
                    class: 'code',
                }) }}
            {% else %}
                <p class="light">{{ 'Trip Planner: not available on this hub.' }}</p>
            {% endif %}

            <hr>
            <h2>llms.txt</h2>

            {{ forms.lightswitchField({
                label: 'Enable llms.txt',
                instructions: 'Publish an llms.txt file in the web root that points AI crawlers to this site\'s official Events and Places pages and sitemap.',
                id: 'enableLlmsTxt',
                name: 'enableLlmsTxt',
                on: settings.enableLlmsTxt,
            }) }}

            {{ forms.textField({
                label: 'Destination name',
                instructions: 'Shown as the llms.txt title. Leave blank to use the site name.',
                id: 'llmsDestinationName',
                name: 'llmsDestinationName',
                value: settings.llmsDestinationName,
                placeholder: currentSite.name,
                errors: settings.getErrors('llmsDestinationName'),
            }) }}

            {{ forms.textField({
                label: 'Organization name',
                instructions: 'Who maintains this information. Leave blank to use the destination name.',
                id: 'llmsOrganizationName',
                name: 'llmsOrganizationName',
                value: settings.llmsOrganizationName,
                placeholder: 'Same as destination name',
                errors: settings.getErrors('llmsOrganizationName'),
            }) }}

            {% if settings.moduleStatus['events'] ?? false %}
                {{ forms.elementSelectField({
                    label: 'Events pages',
                    instructions: 'Pages that show craft.craftIti.eventsList(). They\'re linked from llms.txt.',
                    id: 'llmsEventsEntryIds',
                    name: 'llmsEventsEntryIds',
                    elementType: 'craft\\elements\\Entry',
                    elements: llmsEventsEntries ?? [],
                }) }}
            {% endif %}

            {% if settings.moduleStatus['places'] ?? false %}
                {{ forms.elementSelectField({
                    label: 'Places pages',
                    instructions: 'Pages that show craft.craftIti.placesList(). They\'re linked from llms.txt.',
                    id: 'llmsPlacesEntryIds',
                    name: 'llmsPlacesEntryIds',
                    elementType: 'craft\\elements\\Entry',
                    elements: llmsPlacesEntries ?? [],
                }) }}
            {% endif %}

            {{ forms.lightswitchField({
                label: 'Append to an existing llms.txt',
                instructions: 'If the site already has an llms.txt this plugin didn\'t create, add this plugin\'s section to the end of it. When off, an existing file is left alone.',
                id: 'llmsAppendToExisting',
                name: 'llmsAppendToExisting',
                on: settings.llmsAppendToExisting,
            }) }}

            {% if llmsStatus %}
                {% set llmsStateLabels = {
                    generated: 'Generated by this plugin',
                    appended: 'Appended to an existing file',
                    conflict: 'Conflict: existing file not created by this plugin',
                    dynamic: 'Served dynamically (no file in web root)',
                    none: 'Not published (nothing to list)',
                    unreadable: 'Existing llms.txt can\'t be read: check its permissions',
                } %}
                <div class="field">
                    <div class="heading"><label>llms.txt status</label></div>
                    <div class="input">
                        <p><a href="{{ llmsStatus.url }}" target="_blank" rel="noopener">{{ llmsStatus.url }}</a></p>
                        <p>{{ llmsStateLabels[llmsStatus.state] }}{% if llmsStatus.lastGenerated %} · Last generated {{ llmsStatus.lastGenerated|datetime('short') }}{% endif %}</p>
                        {% if llmsStatus.lastError %}<p class="error">{{ llmsStatus.lastError }}</p>{% endif %}
                    </div>
                </div>
            {% endif %}
            <hr>

            {% if settings.moduleStatus['events'] %}
                {{ forms.lightswitchField({
                    label: 'Enable Event Submission Form',
                    instructions: 'Allow craft.craftIti.eventSubmissionForm() to render an embedded form visitors can use to submit new events for approval. Add the tag to a template to display it. Independent of Enable Events above.',
                    id: 'enableEventSubmissionForm',
                    name: 'enableEventSubmissionForm',
                    on: settings.enableEventSubmissionForm,
                }) }}
            {% else %}
                <p class="light">{{ 'Event submission form: not available on this hub.' }}</p>
            {% endif %}

            {% if settings.moduleStatus['places'] %}
                {{ forms.lightswitchField({
                    label: 'Enable Place Submission Form',
                    instructions: 'Allow craft.craftIti.placeSubmissionForm() to render an embedded form visitors can use to submit new places for approval. Add the tag to a template to display it. Independent of Enable Places above.',
                    id: 'enablePlaceSubmissionForm',
                    name: 'enablePlaceSubmissionForm',
                    on: settings.enablePlaceSubmissionForm,
                }) }}
            {% else %}
                <p class="light">{{ 'Place submission form: not available on this hub.' }}</p>
            {% endif %}

            {{ forms.lightswitchField({
                label: 'Enable Legacy Redirects',
                instructions: 'Redirect old links that carried an event or place id as a query-string parameter to the new clean URL.',
                id: 'enableLegacyRedirects',
                name: 'enableLegacyRedirects',
                on: settings.enableLegacyRedirects,
            }) }}

            {{ forms.textField({
                label: 'Events Listing URL',
                instructions: 'The page where the events listing is rendered, e.g. /events.',
                id: 'eventsListingUrl',
                name: 'eventsListingUrl',
                value: settings.eventsListingUrl,
                errors: settings.getErrors('eventsListingUrl'),
            }) }}

            {{ forms.textField({
                label: 'Legacy Event Id Param',
                instructions: 'The old query-string parameter name that used to carry the event id.',
                id: 'legacyEventIdParam',
                name: 'legacyEventIdParam',
                value: settings.legacyEventIdParam,
            }) }}

            {{ forms.textField({
                label: 'Places Listing URL',
                instructions: 'The page where the places listing is rendered, e.g. /places.',
                id: 'placesListingUrl',
                name: 'placesListingUrl',
                value: settings.placesListingUrl,
                errors: settings.getErrors('placesListingUrl'),
            }) }}

            {{ forms.textField({
                label: 'Legacy Place Id Param',
                instructions: 'The old query-string parameter name that used to carry the place id.',
                id: 'legacyPlaceIdParam',
                name: 'legacyPlaceIdParam',
                value: settings.legacyPlaceIdParam,
            }) }}

            {{ forms.textField({
                label: 'Single Event Route',
                instructions: 'A renameable fallback segment for reaching any event directly, e.g. /event/<id> - always available regardless of any configured listing or base page. Defaults to "event". Pick a segment your site doesn\'t already use for a top-level template or page.',
                id: 'singleEventRoute',
                name: 'singleEventRoute',
                value: settings.singleEventRoute,
                errors: settings.getErrors('singleEventRoute'),
            }) }}

            {{ forms.textField({
                label: 'Single Place Route',
                instructions: 'A renameable fallback segment for reaching any place directly, e.g. /place/<id> - always available regardless of any configured listing or base page. Defaults to "place". Pick a segment your site doesn\'t already use for a top-level template or page.',
                id: 'singlePlaceRoute',
                name: 'singlePlaceRoute',
                value: settings.singlePlaceRoute,
                errors: settings.getErrors('singlePlaceRoute'),
            }) }}

            {{ forms.textField({
                label: 'Event Listing Limit',
                instructions: 'Default number of events to request for listing pages when no per-call limit is set. Maximum allowed value is 100 - this doesn\'t change what a per-call limit filter can still request.',
                id: 'eventListingLimit',
                name: 'eventListingLimit',
                type: 'number',
                min: 1,
                max: 100,
                value: settings.eventListingLimit,
                errors: settings.getErrors('eventListingLimit'),
            }) }}

            {{ forms.textField({
                label: 'Place Listing Limit',
                instructions: 'Default number of places to request for listing pages when no per-call limit is set. Maximum allowed value is 50 - this doesn\'t change what a per-call limit filter can still request.',
                id: 'placeListingLimit',
                name: 'placeListingLimit',
                type: 'number',
                min: 1,
                max: 50,
                value: settings.placeListingLimit,
                errors: settings.getErrors('placeListingLimit'),
            }) }}

            {{ forms.selectField({
                label: 'Canonical URL Source',
                instructions: 'Where the canonical tag on event/place detail pages comes from. SSR Response reuses data already fetched for the page (fast, recommended). Sitemap Feed calls a separate, larger endpoint fresh on every single page load, with no caching — only enable this if ITI Digital has told you to.',
                id: 'canonicalUrlSource',
                name: 'canonicalUrlSource',
                value: settings.canonicalUrlSource,
                options: [
                    { label: 'SSR Response (default)', value: 'ssr' },
                    { label: 'Sitemap Feed (no caching — live request every page load)', value: 'sitemap' },
                ],
            }) }}

            {{ forms.selectField({
                label: 'Sitemap URL trailing slash',
                instructions: 'Controls whether URLs in the generated sitemap, and event/place canonical URLs, end with a slash. Auto follows Craft\'s addTrailingSlashesToUrls setting.',
                id: 'sitemapTrailingSlash',
                name: 'sitemapTrailingSlash',
                value: settings.sitemapTrailingSlash,
                options: [
                    { label: 'Auto (follow site\'s trailing slash setting)', value: 'auto' },
                    { label: 'Always add trailing slash', value: 'always' },
                    { label: 'Never add trailing slash', value: 'never' },
                ],
            }) }}

            {{ forms.textField({
                label: 'Webhook URL',
                instructions: 'Configure this URL in the ITI Digital dashboard\'s webhook settings for this hub.',
                id: 'webhookUrl',
                value: siteUrl(craft.app.config.general.actionTrigger ~ '/craft-iti-plugin/webhook/purge-cache'),
                disabled: true,
            }) }}

            {% set webhookSecretInstructions = 'Copy this value into the ITI Digital dashboard\'s webhook configuration for this hub. Used to authenticate incoming cache-invalidation/module-status webhook calls.' %}
            {% if settings.webhookSecret == '' %}
                {% set webhookSecretInstructions = webhookSecretInstructions ~ ' Not yet generated — this requires an environment where admin changes are allowed (CRAFT_ALLOW_ADMIN_CHANGES=true). Visit this screen there once, then deploy the resulting project config change.' %}
            {% endif %}

            {{ forms.textField({
                label: 'Webhook Secret',
                instructions: webhookSecretInstructions,
                id: 'webhookSecret',
                value: settings.webhookSecret,
                disabled: true,
            }) }}

            {% if settings.enableEvents or settings.enablePlaces %}
                {% set sitemapInstructions = craft.app.plugins.isPluginEnabled('seomatic')
                    ? 'Automatically included in your SEOmatic sitemap index.'
                    : 'Submit this URL in Google Search Console, Bing Webmaster Tools, or your SEO plugin\'s sitemap settings.' %}

                {{ forms.textField({
                    label: 'Sitemap URL',
                    instructions: sitemapInstructions,
                    id: 'sitemapUrl',
                    value: siteUrl('sitemap-events-places.xml'),
                    disabled: true,
                }) }}
            {% endif %}

            <div class="buttons">
                <button type="submit" class="btn submit">{{ 'Save' }}</button>
            </div>
        </form>

        <form method="post" accept-charset="UTF-8" onsubmit="return confirm('Disconnect from ITI Digital?');">
            {{ csrfInput() }}
            {{ actionInput('craft-iti-plugin/settings/disconnect') }}
            {{ redirectInput('settings/plugins/craft-iti-plugin') }}

            <div class="buttons">
                <button type="submit" class="btn">{{ 'Disconnect' }}</button>
            </div>
        </form>
    {% endif %}

    <details class="admin-convenience-guide" style="margin-top: 2rem;">
        <summary><strong>Setup Guide &amp; Twig Reference</strong></summary>

        <h3>Quick Start</h3>
        <ol>
            <li>Connect your hub above and enable the modules you need (Events and/or Places).</li>
            <li>Add <code>{{ '{{ craft.craftIti.eventsList() }}' }}</code> to your events listing template, and <code>{{ '{{ craft.craftIti.placesList() }}' }}</code> to your places listing template.</li>
            <li>Add <code>{{ '{{ craft.craftIti.eventDetail(id) }}' }}</code> / <code>{{ '{{ craft.craftIti.placeDetail(id) }}' }}</code> to your detail templates — or just use the plugin's own default detail templates, which work with zero setup.</li>
        </ol>

        {% set eventsBase = settings.eventsListingUrl is defined and settings.eventsListingUrl ? settings.eventsListingUrl : null %}
        {% set placesBase = settings.placesListingUrl is defined and settings.placesListingUrl ? settings.placesListingUrl : null %}

        <h3>Twig Reference</h3>

        <h4>Listings</h4>
        <pre><code>{{ '{{ craft.craftIti.eventsList() }}' }}</code></pre>
        <p class="light">Renders the events listing widget.</p>

        <pre><code>{{ '{{ craft.craftIti.placesList() }}' }}</code></pre>
        <p class="light">Renders the places listing widget.</p>

        <p class="light">Both accept an optional filters array (<code>listingBaseUrl</code>, <code>detailBaseUrl</code>, <code>page</code>, <code>limit</code>) if you need to override the defaults. With no <code>limit</code> given, each listing uses the Event/Place Listing Limit configured above.</p>

        <h4>Detail pages</h4>
        <pre><code>{{ '{{ craft.craftIti.eventDetail(id) }}' }}</code></pre>
        <p class="light">
            Renders one event's detail content. Always reachable at <code>/e/{{ '<id>' }}</code>{% if eventsBase %}, or nested under your configured listing at <code>{{ eventsBase|trim('/', 'right') }}/e/{{ '<id>' }}</code>{% endif %}, or at your configured fallback route, <code>/{{ settings.singleEventRoute }}/{{ '<id>' }}</code>.
        </p>

        <pre><code>{{ '{{ craft.craftIti.placeDetail(id) }}' }}</code></pre>
        <p class="light">
            Renders one place's detail content. Always reachable at <code>/p/{{ '<id>' }}</code>{% if placesBase %}, or nested under your configured listing at <code>{{ placesBase|trim('/', 'right') }}/p/{{ '<id>' }}</code>{% endif %}, or at your configured fallback route, <code>/{{ settings.singlePlaceRoute }}/{{ '<id>' }}</code>.
        </p>

        <h4>Itineraries</h4>
        <pre><code>{{ '{{ craft.craftIti.itinerariesList({ widgetCode: \'my-widget\' }) }}' }}</code></pre>
        <p class="light">Renders the itineraries listing. <code>widgetCode</code> is optional; without it the Default itinerary widget code above is used.</p>

        <pre><code>{{ '{{ craft.craftIti.itineraryDetail(entry.itineraryId) }}' }}</code></pre>
        <p class="light">Renders one itinerary inside any page. Pass the itinerary id from a plain text field on the entry. It doesn't change the page's SEO tags.</p>

        <h4>Detail pages with SEO data</h4>
        <pre><code>{{ '{% set result = craft.craftIti.eventDetailWithSeo(id) %}' }}
{{ '{{ result.html }}' }}</code></pre>
        <p class="light">Same as <code>eventDetail()</code>, but also returns SEO metadata (<code>result.seo</code>: title, description, canonical, structured data) alongside the rendered HTML in <code>result.html</code> — used by the plugin's own default detail templates.</p>

        <pre><code>{{ '{% set result = craft.craftIti.placeDetailWithSeo(id) %}' }}
{{ '{{ result.html }}' }}</code></pre>
        <p class="light">Same as <code>placeDetail()</code>, for places.</p>

        <h4>Search</h4>
        <pre><code>{{ '{% for r in craft.craftIti.searchEvents(term) %}' }}
    {{ '{{ r.title }} - {{ r.url }}' }}
{{ '{% endfor %}' }}</code></pre>
        <p class="light">Returns matching events for a search term (title, url, image, description) — call this from your own site's search results template; this plugin doesn't render a search page of its own. Both accept an optional second argument, <code>detailBaseUrl</code>, to override the default detail link base.</p>

        <pre><code>{{ '{% for r in craft.craftIti.searchPlaces(term) %}' }}
    {{ '{{ r.title }} - {{ r.url }}' }}
{{ '{% endfor %}' }}</code></pre>
        <p class="light">Same as <code>searchEvents()</code>, for places.</p>

        <h4>Submission forms</h4>
        <pre><code>{{ '{{ craft.craftIti.eventSubmissionForm() }}' }}</code></pre>
        <p class="light">Renders an embedded form visitors can use to submit a new event for approval. Requires the Enable Event Submission Form toggle above.</p>

        <pre><code>{{ '{{ craft.craftIti.placeSubmissionForm() }}' }}</code></pre>
        <p class="light">Same as <code>eventSubmissionForm()</code>, for places.</p>

        <p class="light">Only one ITI Digital widget can bootstrap per page — don't combine a submission form with another submission form, with eventsList()/placesList(), or with an event/place detail embed on the same page. Give the submission form its own page.</p>
    </details>

    <details class="admin-convenience-tag-builder" style="margin-top: 2rem;">
        <summary><strong>Tag Builder</strong></summary>

        <p class="light">Pick a content type and toggle the filters you want — the Twig snippet below updates automatically.</p>

        <div class="field">
            <div class="heading"><label for="craftItiTagBuilderType">Content type</label></div>
            <div class="input">
                <select id="craftItiTagBuilderType">
                    <option value="events" selected>Events</option>
                    <option value="places">Places</option>
                </select>
            </div>
        </div>

        <div id="craftItiTagBuilderEvents" class="craft-iti-tag-builder-panel">
            <h4>Events filters</h4>

            <p><label><input type="checkbox" data-filter-key="oneRow" data-filter-type="bool"> One row</label></p>
            <p><label><input type="checkbox" data-filter-key="editorChoice" data-filter-type="bool"> Editor's choice</label></p>
            <p><label>Favorite category ID <input type="text" data-filter-key="favEventCategoryId" data-filter-type="string"></label></p>
            <p><label>Location group ID <input type="text" data-filter-key="locationGroupId" data-filter-type="string"></label></p>

            <fieldset>
                <legend>Date filter</legend>
                <p><label><input type="radio" name="craftItiEventsDateMode" value="none" checked> None</label></p>
                <p><label><input type="radio" name="craftItiEventsDateMode" value="date"> Specific date</label></p>
                <p><label><input type="radio" name="craftItiEventsDateMode" value="range"> Date range</label></p>

                <div data-date-mode-fields="date" hidden>
                    <p><label>Date <input type="text" data-filter-key="date" data-filter-type="string" placeholder="today"></label></p>
                </div>
                <div data-date-mode-fields="range" hidden>
                    <p><label>Start <input type="text" data-filter-key="start" data-filter-type="string" placeholder="2026-08-01"></label></p>
                    <p><label>End <input type="text" data-filter-key="end" data-filter-type="string" placeholder="2026-08-31"></label></p>
                </div>
            </fieldset>

            <p><label>Limit <input type="number" data-filter-key="limit" data-filter-type="int" placeholder="{{ settings.eventListingLimit }}" min="1" max="100"></label></p>
        </div>

        <div id="craftItiTagBuilderPlaces" class="craft-iti-tag-builder-panel" hidden>
            <h4>Places filters</h4>

            <p><label><input type="checkbox" data-filter-key="editorChoice" data-filter-type="bool"> Editor's choice</label></p>
            <p><label>Custom category ID <input type="text" data-filter-key="customCategoryId" data-filter-type="string"></label></p>
            <p><label>Favorite listing ID <input type="text" data-filter-key="favListingId" data-filter-type="string"></label></p>
            <p><label>Location group ID <input type="text" data-filter-key="locationGroupId" data-filter-type="string"></label></p>
            <p><label>Limit <input type="number" data-filter-key="limit" data-filter-type="int" placeholder="{{ settings.placeListingLimit }}" min="1" max="50"></label></p>
        </div>

        <div class="buttons">
            <button type="button" class="btn" id="craftItiTagBuilderCopy">{{ 'Copy snippet' }}</button>
            <button type="button" class="btn" id="craftItiTagBuilderReset">{{ 'Reset' }}</button>
        </div>

        <pre><code id="craftItiTagBuilderOutput"></code></pre>

        <script>
        {% verbatim %}
        (function () {
            var typeSelect = document.getElementById('craftItiTagBuilderType');
            var panels = {
                events: document.getElementById('craftItiTagBuilderEvents'),
                places: document.getElementById('craftItiTagBuilderPlaces')
            };
            var methodNames = { events: 'eventsList', places: 'placesList' };
            var output = document.getElementById('craftItiTagBuilderOutput');
            var copyButton = document.getElementById('craftItiTagBuilderCopy');
            var resetButton = document.getElementById('craftItiTagBuilderReset');

            function currentType() {
                return typeSelect.value === 'places' ? 'places' : 'events';
            }

            function currentPanel() {
                return panels[currentType()];
            }

            function escapeSingleQuotes(value) {
                return value.replace(/'/g, "\\'");
            }

            function collectFilters(panel) {
                var filters = {};

                panel.querySelectorAll('[data-filter-key]').forEach(function (field) {
                    var group = field.closest('[data-date-mode-fields]');
                    if (group && group.hidden) {
                        return;
                    }

                    var key = field.getAttribute('data-filter-key');
                    var type = field.getAttribute('data-filter-type');

                    if (type === 'bool') {
                        if (field.checked) {
                            filters[key] = true;
                        }
                        return;
                    }

                    var value = field.value.trim();
                    if (value === '') {
                        return;
                    }

                    filters[key] = type === 'int' ? parseInt(value, 10) : value;
                });

                return filters;
            }

            function buildSnippet(type, filters) {
                var method = methodNames[type];
                var keys = Object.keys(filters);

                if (keys.length === 0) {
                    return '{{ craft.craftIti.' + method + '() }}';
                }

                var pairs = keys.map(function (key) {
                    var value = filters[key];

                    if (typeof value === 'boolean') {
                        return key + ': true';
                    }

                    if (typeof value === 'number') {
                        return key + ': ' + value;
                    }

                    return key + ": '" + escapeSingleQuotes(value) + "'";
                });

                return '{{ craft.craftIti.' + method + '({ ' + pairs.join(', ') + ' }) }}';
            }

            function render() {
                var type = currentType();
                var filters = collectFilters(currentPanel());
                output.textContent = buildSnippet(type, filters);
            }

            function updateDateModeVisibility(panel) {
                var checked = panel.querySelector('input[name="craftItiEventsDateMode"]:checked');
                var mode = checked ? checked.value : 'none';

                panel.querySelectorAll('[data-date-mode-fields]').forEach(function (group) {
                    group.hidden = group.getAttribute('data-date-mode-fields') !== mode;
                });
            }

            typeSelect.addEventListener('change', function () {
                var type = currentType();
                panels.events.hidden = type !== 'events';
                panels.places.hidden = type !== 'places';
                render();
            });

            Object.keys(panels).forEach(function (type) {
                var panel = panels[type];

                panel.addEventListener('input', render);
                panel.addEventListener('change', function (event) {
                    if (event.target.name === 'craftItiEventsDateMode') {
                        updateDateModeVisibility(panel);
                    }
                    render();
                });
            });

            function fallbackCopy(text) {
                var textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.focus();
                textarea.select();

                try {
                    document.execCommand('copy');
                } catch (e) {
                    // Nothing more we can do here - the snippet is still visible to copy by hand.
                }

                document.body.removeChild(textarea);
            }

            copyButton.addEventListener('click', function () {
                var text = output.textContent;

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).catch(function () {
                        fallbackCopy(text);
                    });
                    return;
                }

                fallbackCopy(text);
            });

            resetButton.addEventListener('click', function () {
                var panel = currentPanel();

                panel.querySelectorAll('input[type="checkbox"]').forEach(function (field) {
                    field.checked = false;
                });

                panel.querySelectorAll('input[type="text"], input[type="number"]').forEach(function (field) {
                    field.value = '';
                });

                var noneRadio = panel.querySelector('input[name="craftItiEventsDateMode"][value="none"]');
                if (noneRadio) {
                    noneRadio.checked = true;
                    updateDateModeVisibility(panel);
                }

                render();
            });

            updateDateModeVisibility(panels.events);
            render();
        })();
        {% endverbatim %}
        </script>
