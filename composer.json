{
    "name": "iti/craft-iti-plugin",
    "description": "Craft ITI Plugin - injects plugin-managed content into a marked section of any page.",
    "type": "craft-plugin",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "iti\\craftitiplugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "iti\\craftitiplugin\\tests\\": "tests/"
        }
    },
    "extra": {
        "name": "Craft ITI Plugin",
        "handle": "craft-iti-plugin"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    }
}
