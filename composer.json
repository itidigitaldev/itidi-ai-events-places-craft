{
    "name": "iti/craft-iti-plugin",
    "description": "Server-side rendered, SEO-friendly Events, Places and Itineraries from the ITI Digital platform for Craft CMS, with clean URLs, structured data, sitemap, llms.txt and Trip Planner.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "events",
        "places",
        "itineraries",
        "tourism",
        "seo",
        "sitemap",
        "llms-txt"
    ],
    "license": "MIT",
    "homepage": "https://github.com/itidigitaldev/itidi-ai-events-places-craft",
    "support": {
        "docs": "https://github.com/itidigitaldev/itidi-ai-events-places-craft/blob/main/README.md",
        "issues": "https://github.com/itidigitaldev/itidi-ai-events-places-craft/issues",
        "source": "https://github.com/itidigitaldev/itidi-ai-events-places-craft"
    },
    "authors": [
        {
            "name": "ITI Digital",
            "homepage": "https://iti-digital.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "nystudio107/craft-seomatic": "Adds the events/places sitemap to SEOmatic's sitemap index",
        "putyourlightson/craft-blitz": "Enables cache purging for affected URLs when the plugin's cache-invalidation webhook is called"
    },
    "autoload": {
        "psr-4": {
            "iti\\craftitiplugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "iti\\craftitiplugin\\tests\\": "tests/"
        }
    },
    "extra": {
        "name": "ITI Digital AI-Ready Events & Places",
        "handle": "craft-iti-plugin",
        "developer": "ITI Digital",
        "developerUrl": "https://iti-digital.com",
        "documentationUrl": "https://github.com/itidigitaldev/itidi-ai-events-places-craft/blob/main/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/itidigitaldev/itidi-ai-events-places-craft/main/CHANGELOG.md",
        "description": "AI-ready Events, Places and Itineraries from your ITI Digital hub, rendered server-side with clean URLs, structured data, sitemap and llms.txt."
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    }
}
